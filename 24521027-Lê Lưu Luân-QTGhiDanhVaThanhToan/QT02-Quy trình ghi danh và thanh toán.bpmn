      <bpmn:outgoing>Flow_0ddaqb1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="NotifyExpiration" name="Thông báo hết hạn">
      <bpmn:incoming>Flow_16wf81h</bpmn:incoming>
      <bpmn:outgoing>Flow_04twwtc</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="NotifyFailure" name="Thông báo lỗi/bị hủy">
      <bpmn:incoming>Flow_15s7mkg</bpmn:incoming>
      <bpmn:outgoing>Flow_1s8pxms</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:sequenceFlow id="Flow_04twwtc" sourceRef="NotifyExpiration" targetRef="EndEvent_PaymentExpired" />
    <bpmn:sequenceFlow id="Flow_1leace2" sourceRef="CheckCondition" targetRef="IsPaidCourse" />
    <bpmn:sequenceFlow id="Flow_0kkzy9y" name="Có" sourceRef="IsPaidCourse" targetRef="InitPayment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${co_phi == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0w6naz0" name="Không" sourceRef="IsPaidCourse" targetRef="GrantAccess">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${co_phi == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_14msv9g" sourceRef="InitPayment" targetRef="WaitForPayment" />
    <bpmn:sequenceFlow id="Flow_16wf81h" name="Hết hạn OTP/QR" sourceRef="WaitForPayment" targetRef="NotifyExpiration" />
    <bpmn:sequenceFlow id="Flow_04smonv" sourceRef="WaitForPayment" targetRef="IsPaymentSuccessful" />
    <bpmn:sequenceFlow id="Flow_0tr8364" name="Thành công" sourceRef="IsPaymentSuccessful" targetRef="GrantAccess">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${thanh_toan == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_15s7mkg" name="Không thành công" sourceRef="IsPaymentSuccessful" targetRef="NotifyFailure">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${thanh_toan == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1s8pxms" sourceRef="NotifyFailure" targetRef="EndEvent_OrderCancelled" />
    <bpmn:sequenceFlow id="Flow_034p2zs" sourceRef="GrantAccess" targetRef="EndEvent_EnrollmentSuccess" />
    <bpmn:sequenceFlow id="Flow_0hi031m" sourceRef="SubmitEnrollmentInfo" targetRef="CheckCondition" />
    <bpmn:sequenceFlow id="Flow_0ddaqb1" sourceRef="StartEvent_ChooseCourse" targetRef="SubmitEnrollmentInfo" />
    <bpmn:userTask id="WaitForPayment" name="Đợi phản hồi">
      <bpmn:incoming>Flow_14msv9g</bpmn:incoming>
      <bpmn:outgoing>Flow_16wf81h</bpmn:outgoing>
      <bpmn:outgoing>Flow_04smonv</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="TimerEvent_PaymentTimeout" attachedToRef="WaitForPayment">
      <bpmn:timerEventDefinition id="TimerEventDefinition_0a6mhmw">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
  </bpmn:process>
