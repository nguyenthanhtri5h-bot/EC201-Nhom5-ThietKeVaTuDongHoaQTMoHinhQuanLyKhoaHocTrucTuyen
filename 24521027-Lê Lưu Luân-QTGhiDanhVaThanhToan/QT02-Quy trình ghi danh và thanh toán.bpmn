  <bpmn:process id="Process_0q3q9g8" name="QT02-Quy trình ghi danh và thanh toán" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:laneSet id="LaneSet_1c8in6r">
      <bpmn:lane id="Lane_068dcyn" name="System Worker">
        <bpmn:flowNodeRef>EndEvent_EnrollmentSuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GrantAccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CheckCondition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InitPayment</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_0d7wgrw" name="Hệ thống LMS">
        <bpmn:flowNodeRef>EndEvent_PaymentExpired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IsPaidCourse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IsPaymentSuccessful</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_OrderCancelled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubmitEnrollmentInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_ChooseCourse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NotifyExpiration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NotifyFailure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WaitForPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TimerEvent_PaymentTimeout</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:endEvent id="EndEvent_PaymentExpired" name="Quá trình thanh toán hết hạn">
      <bpmn:incoming>Flow_04twwtc</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="IsPaidCourse" name="Khóa học có phí?">
      <bpmn:incoming>Flow_1leace2</bpmn:incoming>
      <bpmn:outgoing>Flow_0kkzy9y</bpmn:outgoing>
      <bpmn:outgoing>Flow_0w6naz0</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="IsPaymentSuccessful" name="Thanh toán thành công?">
      <bpmn:incoming>Flow_04smonv</bpmn:incoming>
      <bpmn:outgoing>Flow_0tr8364</bpmn:outgoing>
      <bpmn:outgoing>Flow_15s7mkg</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_OrderCancelled" name="Đơn hàng bị hủy">
      <bpmn:incoming>Flow_1s8pxms</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_EnrollmentSuccess" name="Ghi danh thành công">
      <bpmn:incoming>Flow_034p2zs</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="GrantAccess" name="Cấp quyền truy cập khóa học" camunda:type="external" camunda:topic="grant-access">
      <bpmn:incoming>Flow_0tr8364</bpmn:incoming>
      <bpmn:incoming>Flow_0w6naz0</bpmn:incoming>
      <bpmn:outgoing>Flow_034p2zs</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="CheckCondition" name="Xác thực ban đầu" camunda:type="external" camunda:topic="check-condition">
      <bpmn:incoming>Flow_0hi031m</bpmn:incoming>
      <bpmn:outgoing>Flow_1leace2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="InitPayment" name="Khởi tạo thanh toán" camunda:type="external" camunda:topic="init-payment">
      <bpmn:incoming>Flow_0kkzy9y</bpmn:incoming>
      <bpmn:outgoing>Flow_14msv9g</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="SubmitEnrollmentInfo" name="Cung cấp thông tin ghi danh" camunda:formRef="form_ghi_danh" camunda:formRefBinding="latest">
      <bpmn:incoming>Flow_0ddaqb1</bpmn:incoming>
      <bpmn:outgoing>Flow_0hi031m</bpmn:outgoing>
    </bpmn:userTask>
